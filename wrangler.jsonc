{
  "name": "cardapio-boteco-do-ze",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Imagens enviadas pelo painel. As fotos versionadas continuam em
  // public/images/ (servidas por ASSETS); só o upload vai para o R2.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "boteco-ze-media"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
